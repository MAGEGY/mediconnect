{
  "expo": {
    "name": "MediConnect",
    "slug": "mediconnect",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mediconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/bd1826a8-99a7-4f69-af33-506554bfd939"
    },
    "platforms": ["ios", "android", "web"],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mediconnect.app",
      "buildNumber": "2.0.0"
    },
    "android": {
      "package": "com.mediconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#0077B6"
      },
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "mediconnect",
              "host": "medication"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0077B6"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MediConnect to access your camera to scan medicine packages."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MediConnect to use Face ID for secure login.",
          "allowDeviceAccount": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your healthcare provider.",
          "cameraPermission": "Allow MediConnect to access your camera to take photos of your medications."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": false,
      "tsconfigPaths": true,
      "typedRoutes": true,
      "baseUrl": "/mediconnect"
    },
    "extra": {
      "apiUrl": "${API_URL}",
      "googleMapsApiKey": "${GOOGLE_MAPS_API_KEY}",
      "ocrApiKey": "${OCR_API_KEY}",
      "eas": {
        "projectId": "71cccecc-a7c4-4ba5-aae0-4e71ce75e8ef"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#ffffff"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0077B6"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0077B6",
      "dark": {
        "image": "./assets/images/icon.png",
        "backgroundColor": "#0077B6"
      }
    },
    "owner": "magegy"
  }
}
